##1

jiang <- read.delim("Jiang2013_data.csv")
names(jiang)         
unique(jiang$Taxon)
sum(is.na(jiang$r))
table(jiang$Taxon)


mean_r <- function(taxon){
  mean(jiang$r[jiang$Taxon == taxon])
}


##2

taxon_p <- function(taxon){
  obs <- mean_r(taxon)
  n <- sum(jiang$Taxon == taxon)
  rand_means <- c()
  for(i in 1:50000){
    rand_means[i] <- mean(sample(jiang$r, size = n))
  }
  sum(rand_means >= obs) / 50000
}

tax <- unique(jiang$Taxon)
results <- data.frame(Taxon = tax,
                      n = as.vector(table(jiang$Taxon)[tax]),
                      mean_r = sapply(tax, mean_r),
                      p = sapply(tax, taxon_p))
results


