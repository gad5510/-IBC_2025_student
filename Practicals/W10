toads <- read.delim("Toad_Handedness.tsv")
str(toads)
table(toads$Sex)

nExp <- 100000

sim_toad <- function(right, n, nExp = 100000){
  sims <- rbinom(nExp, size = n, prob = 0.5)
  mean(abs(sims - n/2) >= abs(right - n/2))
}


toads$p <- mapply(sim_toad, toads$N_rights, toads$N_trials)
toads$handedness <- ifelse(toads$p >= 0.05, "none",
                           ifelse(toads$N_rights > toads$N_trials/2, "right", "left"))
toads[, c("Toad", "Sex", "N_rights", "N_trials", "p", "handedness")]

##2

handed <- toads[toads$handedness != "none", ]
nHanded <- nrow(handed)
nRightToads <- sum(handed$handedness == "right")

sims <- rbinom(nExp, size = nHanded, prob = 0.5)
p2 <- mean(abs(sims - nHanded/2) >= abs(nRightToads - nHanded/2))
nHanded; nRightToads; p2

