##3

toads$prop_right <- toads$N_rights / toads$N_trials

obs_diff <- mean(toads$prop_right[toads$Sex == "M"]) -
  mean(toads$prop_right[toads$Sex == "F"])

nPer <- 10000
diffs <- numeric(nPer)
for(i in 1:nPer){
  shuf <- sample(toads$Sex)
  diffs[i] <- mean(toads$prop_right[shuf == "M"]) -
    mean(toads$prop_right[shuf == "F"])
}
p3 <- sum(abs(diffs) >= abs(obs_diff)) / nPer
obs_diff; p3

